{
  "name": "obsidian-kurotsuki-sync",
  "version": "1.2.5",
  "description": "Self-hosted real-time collaborative editing and local-first vault synchronization for Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "test:bundle": "esbuild tests/sync-engine.test.ts --bundle --platform=node --format=esm --outfile=dist-test/sync-engine.test.js --external:obsidian --external:electron",
    "pretest": "npm run test:bundle",
    "test": "node --test dist-test/**/*.test.js"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "collaboration",
    "relay",
    "crdt",
    "sync",
    "yjs"
  ],
  "author": "Kurotsuki",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.12.7",
    "esbuild": "^0.20.2",
    "obsidian": "^1.5.7",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.14"
  }
}
