# Caddy configuration for automatic HTTPS reverse-proxying
# Replace {$DOMAIN} with your actual domain name, e.g. sync.example.com

{$DOMAIN:localhost} {
    encode gzip zstd

    # WebSocket and API reverse proxy
    reverse_proxy kurotsuki-relay:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
