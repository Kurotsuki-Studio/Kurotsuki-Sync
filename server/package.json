{
  "name": "kurotsuki-sync-server",
  "version": "1.0.0",
  "description": "Self-hosted cloud relay and CRDT synchronization server for Kurotsuki Sync (Obsidian Relay alternative)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "node --test dist-test/**/*.test.js || tsx --test tests/**/*.test.ts"
  },
  "keywords": [
    "obsidian",
    "relay",
    "crdt",
    "yjs",
    "websocket",
    "self-hosted",
    "collaboration"
  ],
  "author": "Kurotsuki",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.16.0",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.14"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/ws": "^8.5.10",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
