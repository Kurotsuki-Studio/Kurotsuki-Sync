# Kurotsuki Sync Relay Server Configuration

# Network Port and Host
PORT=3000
HOST=0.0.0.0

# Persistent Data Storage Path
STORAGE_DIR=./data

# Authentication Secret Token (leave empty for open access, or specify a strong token)
AUTH_TOKEN=your-ultra-secure-secret-token-here

# Maximum payload size for binary attachments in Megabytes
MAX_PAYLOAD_MB=50

# Enable CORS for web/browser clients
CORS_ENABLED=true
